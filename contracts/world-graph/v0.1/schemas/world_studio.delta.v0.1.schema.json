{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-studio:schema:world_studio.delta.v0.1",
  "title": "World Studio Immutable Delta v0.1",
  "description": "Active reversible Delta contract. Each operation records typed before and after state, while authority_effect remains none.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "delta_id",
    "scope",
    "parent",
    "result",
    "created_at",
    "intent",
    "operations",
    "authority_effect",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "world_studio.delta.v0.1"
    },
    "delta_id": {
      "$ref": "urn:world-studio:schema:world_studio.world_graph_defs.v0.1#/$defs/identifier"
    },
    "scope": {
      "enum": [
        "world",
        "asset"
      ]
    },
    "parent": {
      "$ref": "urn:world-studio:schema:world_studio.world_graph_defs.v0.1#/$defs/revisionReference"
    },
    "result": {
      "$ref": "urn:world-studio:schema:world_studio.world_graph_defs.v0.1#/$defs/revisionIdentity"
    },
    "created_at": {
      "$ref": "urn:world-studio:schema:world_studio.world_graph_defs.v0.1#/$defs/timestamp"
    },
    "intent": {
      "enum": [
        "crop",
        "transform",
        "filter",
        "merge",
        "hide",
        "replace",
        "objectize",
        "annotate"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "urn:world-studio:schema:world_studio.world_graph_defs.v0.1#/$defs/deltaOperation"
      }
    },
    "authority_effect": {
      "const": "none"
    },
    "provenance": {
      "$ref": "urn:world-studio:schema:world_studio.world_graph_defs.v0.1#/$defs/provenance"
    }
  }
}
