{
  "$id": "urn:world-studio:schema:capture_splat.training_dataset.v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "capture_evidence_only": { "const": true },
        "collision_authority": { "const": false },
        "metric_authority": { "const": false },
        "quality_claim": { "const": false },
        "trainer_consumption_claim": { "const": false },
        "training_execution_authority": { "const": false }
      },
      "required": [
        "capture_evidence_only", "trainer_consumption_claim", "training_execution_authority",
        "quality_claim", "metric_authority", "collision_authority"
      ],
      "type": "object"
    },
    "capture_profile": { "$ref": "#/$defs/identifier" },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "capture_manifest": { "$ref": "#/$defs/captureManifestEvidence" },
        "confidence": { "$ref": "#/$defs/frameEvidence" },
        "depth": { "$ref": "#/$defs/frameEvidence" },
        "masks": { "$ref": "#/$defs/frameEvidence" },
        "mesh": { "$ref": "#/$defs/meshEvidence" },
        "sfm": { "$ref": "#/$defs/sfmEvidence" }
      },
      "required": ["capture_manifest", "sfm", "depth", "confidence", "masks", "mesh"],
      "type": "object"
    },
    "projection": {
      "$ref": "#/$defs/projection"
    },
    "schema": { "const": "capture_splat.training_dataset.v0.1" },
    "source_frame_set": {
      "additionalProperties": false,
      "properties": {
        "canonicalization": { "const": "utf8_relative_path_nul_size_nul_sha256_lf_v1" },
        "count": { "$ref": "#/$defs/positiveSafeInteger" },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "required": ["count", "digest", "canonicalization"],
      "type": "object"
    }
  },
  "required": ["schema", "capture_profile", "source_frame_set", "projection", "evidence", "authority"],
  "title": "Capture Splat training dataset v0.1 consumer contract",
  "type": "object",
  "$defs": {
    "captureManifestEvidence": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "asset": { "const": "capture_manifest" },
            "available": { "const": true }
          },
          "required": ["available", "asset"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "asset": { "type": "null" },
            "available": { "const": false }
          },
          "required": ["available", "asset"],
          "type": "object"
        }
      ]
    },
    "frameEvidence": {
      "additionalProperties": false,
      "properties": {
        "available_frame_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "referenced_frame_count": { "$ref": "#/$defs/nonNegativeSafeInteger" }
      },
      "required": ["referenced_frame_count", "available_frame_count"],
      "type": "object"
    },
    "identifier": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "meshEvidence": {
      "additionalProperties": false,
      "properties": {
        "asset": { "enum": ["navigation_mesh", null] },
        "available": { "type": "boolean" },
        "report_asset": { "enum": ["mesh_report", null] },
        "report_available": { "type": "boolean" }
      },
      "required": ["available", "asset", "report_available", "report_asset"],
      "type": "object"
    },
    "nonNegativeSafeInteger": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "positiveSafeInteger": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "projection": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "perspective" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "native_equirectangular": { "const": false },
              "rig_evidence": { "properties": { "available": { "const": false } }, "type": "object" },
              "source_is_equirectangular": { "const": false },
              "training_images_are_projected_pinhole": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "projected_pinhole_from_equirectangular" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "native_equirectangular": { "const": false },
              "rig_evidence": { "properties": { "available": { "const": true } }, "type": "object" },
              "source_is_equirectangular": { "const": true },
              "training_images_are_projected_pinhole": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "native_equirectangular" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "native_equirectangular": { "const": true },
              "rig_evidence": { "properties": { "available": { "const": true } }, "type": "object" },
              "source_is_equirectangular": { "const": true },
              "training_images_are_projected_pinhole": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "unresolved_equirectangular_source" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "native_equirectangular": { "const": false },
              "rig_evidence": { "properties": { "available": { "const": true } }, "type": "object" },
              "source_is_equirectangular": { "const": true },
              "training_images_are_projected_pinhole": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "unresolved_360_source" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "native_equirectangular": { "const": false },
              "rig_evidence": { "properties": { "available": { "const": false } }, "type": "object" },
              "source_is_equirectangular": { "type": "null" },
              "training_images_are_projected_pinhole": { "const": false }
            }
          }
        }
      ],
      "properties": {
        "mode": {
          "enum": [
            "perspective", "projected_pinhole_from_equirectangular", "native_equirectangular",
            "unresolved_equirectangular_source", "unresolved_360_source"
          ]
        },
        "native_equirectangular": { "type": "boolean" },
        "rig_evidence": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": { "available": { "const": false } },
              "required": ["available"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "available": { "const": true },
                "checksum": { "$ref": "#/$defs/sha256" },
                "schema": { "const": "capture_splat.equirectangular_rig.v0.1" }
              },
              "required": ["available", "schema", "checksum"],
              "type": "object"
            }
          ]
        },
        "source_is_equirectangular": { "type": ["boolean", "null"] },
        "training_images_are_projected_pinhole": { "type": "boolean" }
      },
      "required": [
        "mode", "source_is_equirectangular", "training_images_are_projected_pinhole",
        "native_equirectangular", "rig_evidence"
      ],
      "type": "object"
    },
    "registeredRgbdOverlap": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ambiguous_basename_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
            "available": { "const": true },
            "depth_bearing_capture_frame_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
            "matched_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
            "matched_name_digest": { "$ref": "#/$defs/sha256" },
            "matching": { "const": "unique_case_sensitive_rgb_basename_with_same_root_rgb_and_depth_v1" },
            "unmatched_registered_image_count": { "$ref": "#/$defs/nonNegativeSafeInteger" }
          },
          "required": [
            "available", "matching", "depth_bearing_capture_frame_count", "matched_count",
            "matched_name_digest", "ambiguous_basename_count", "unmatched_registered_image_count"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ambiguous_basename_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
            "available": { "const": false },
            "depth_bearing_capture_frame_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
            "matched_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
            "matching": { "const": "unique_case_sensitive_rgb_basename_with_same_root_rgb_and_depth_v1" },
            "reason": {
              "enum": [
                "colmap_images_unavailable", "colmap_images_parse_incomplete",
                "capture_manifest_unavailable", "capture_frames_invalid"
              ]
            },
            "unmatched_registered_image_count": { "$ref": "#/$defs/nonNegativeSafeInteger" }
          },
          "required": [
            "available", "reason", "matching", "depth_bearing_capture_frame_count",
            "matched_count", "ambiguous_basename_count", "unmatched_registered_image_count"
          ],
          "type": "object"
        }
      ]
    },
    "sfmEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/sfmEvidenceLegacy" },
        { "$ref": "#/$defs/sfmEvidenceMeasured" }
      ]
    },
    "sfmEvidenceLegacy": {
      "additionalProperties": false,
      "properties": {
        "asset": { "enum": ["colmap_sparse", null] },
        "available": { "type": "boolean" },
        "camera_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "camera_models": {
          "items": { "maxLength": 64, "pattern": "^[A-Z0-9_]+$", "type": "string" },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "registered_images_available": { "type": "boolean" },
        "sparse_points_available": { "type": "boolean" }
      },
      "required": [
        "available", "camera_count", "camera_models", "registered_images_available",
        "sparse_points_available", "asset"
      ],
      "type": "object"
    },
    "sfmEvidenceMeasured": {
      "additionalProperties": false,
      "properties": {
        "asset": { "enum": ["colmap_sparse", null] },
        "available": { "type": "boolean" },
        "camera_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "camera_models": {
          "items": { "maxLength": 64, "pattern": "^[A-Z0-9_]+$", "type": "string" },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "registered_image_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "registered_image_invalid_record_count": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "registered_image_name_digest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "registered_image_parse_status": { "enum": ["complete", "partial", "unavailable"] },
        "registered_images_available": { "type": "boolean" },
        "registered_rgbd_overlap": { "$ref": "#/$defs/registeredRgbdOverlap" },
        "registered_rgbd_overlap_count": {
          "oneOf": [
            { "$ref": "#/$defs/nonNegativeSafeInteger" },
            { "type": "null" }
          ]
        },
        "sparse_points_available": { "type": "boolean" }
      },
      "required": [
        "available", "camera_count", "camera_models", "registered_images_available",
        "registered_image_count", "registered_image_parse_status",
        "registered_image_invalid_record_count", "registered_image_name_digest",
        "registered_rgbd_overlap_count", "registered_rgbd_overlap",
        "sparse_points_available", "asset"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
