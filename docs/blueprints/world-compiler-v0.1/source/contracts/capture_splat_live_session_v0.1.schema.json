{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capturesplat.dev/schemas/capture_splat.live_session.v0.1.schema.json",
  "title": "CaptureSplat Live Session Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "message_type",
    "session_id",
    "message_id",
    "sent_at",
    "body"
  ],
  "properties": {
    "schema": {
      "const": "capture_splat.live_session.v0.1"
    },
    "message_type": {
      "enum": [
        "session_open",
        "frame_manifest",
        "artifact_offer",
        "ack",
        "reconcile_request",
        "reconcile_response",
        "session_close",
        "error"
      ]
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{3,128}$"
    },
    "message_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "frame_manifest"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/frameManifest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "ack"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/ack"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\x00)[A-Za-z0-9._@+ -]+(?:/[A-Za-z0-9._@+ -]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "relative_path",
        "byte_length",
        "sha256",
        "local_write_completed_at"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "rgb",
            "depth",
            "confidence",
            "mask",
            "thumbnail",
            "mesh_chunk",
            "metadata"
          ]
        },
        "relative_path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string"
        },
        "compression": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_write_completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "frameManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "sequence_id",
        "capture_time_ns",
        "pose",
        "intrinsics",
        "quality",
        "artifacts"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_id": {
          "type": "integer",
          "minimum": 0
        },
        "capture_time_ns": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_time": {
          "type": "string",
          "format": "date-time"
        },
        "pose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "convention",
            "frame_id",
            "matrix_row_major"
          ],
          "properties": {
            "convention": {
              "enum": [
                "camera_to_world",
                "world_to_camera"
              ]
            },
            "frame_id": {
              "type": "string"
            },
            "matrix_row_major": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "intrinsics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "fx",
            "fy",
            "cx",
            "cy"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "fx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fy": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "distortion_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "distortion_coefficients": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "blur": {
              "type": "number"
            },
            "exposure": {
              "type": "number"
            },
            "tracking_state": {
              "type": "string"
            },
            "accepted_reason": {
              "type": "string"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acked_message_id",
        "status"
      ],
      "properties": {
        "acked_message_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "already_present",
            "retry",
            "rejected",
            "conflict"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
